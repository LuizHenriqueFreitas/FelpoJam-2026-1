[sub_resource type="Shader" id="Shader_dakft"]
code = "shader_type canvas_item;

// Tamanho do \"pixel\" — aumente para pixelizar mais (recomendado: 3 a 6)
uniform int pixel_size : hint_range(1, 16) = 4;

// Redução de cores (posterização) — simula paleta limitada estilo Diablo 1
// 0 = desativado, valores entre 4 e 16 dão o efeito retrô
uniform int color_levels : hint_range(0, 32) = 8;

// Intensidade do dithering estilo ordered (pontilhado retrô)
uniform float dither_strength : hint_range(0.0, 1.0) = 0.15;

// Leve vinheta nas bordas para dar aquela atmosfera sombria do Diablo
uniform float vignette_strength : hint_range(0.0, 1.0) = 0.4;

// Matriz de dithering Bayer 4x4
float bayer4x4(vec2 pos) {
	int x = int(mod(pos.x, 4.0));
	int y = int(mod(pos.y, 4.0));

	int matrix[16] = int[16](
		 0,  8,  2, 10,
		12,  4, 14,  6,
		 3, 11,  1,  9,
		15,  7, 13,  5
	);

	return float(matrix[y * 4 + x]) / 16.0 - 0.5;
}

void fragment() {
	vec2 tex_size = vec2(textureSize(TEXTURE, 0));

	// ── Pixelização ──────────────────────────────────────────────────────────
	float ps = float(pixel_size);
	vec2 pixelated_uv = floor(UV * tex_size / ps) * ps / tex_size;
	vec4 color = texture(TEXTURE, pixelated_uv);

	// ── Dithering (pontilhado retrô) ─────────────────────────────────────────
	if (dither_strength > 0.0) {
		vec2 screen_pos = pixelated_uv * tex_size / ps;
		float dither = bayer4x4(screen_pos) * dither_strength;
		color.rgb += vec3(dither);
	}

	// ── Posterização (paleta limitada) ───────────────────────────────────────
	if (color_levels > 0) {
		float levels = float(color_levels);
		color.rgb = floor(color.rgb * levels + 0.5) / levels;
	}

	// ── Vinheta escura nas bordas ────────────────────────────────────────────
	if (vignette_strength > 0.0) {
		vec2 center = UV - 0.5;
		float vignette = 1.0 - dot(center, center) * 2.5;
		vignette = clamp(vignette, 0.0, 1.0);
		vignette = mix(1.0, vignette, vignette_strength);
		color.rgb *= vignette;
	}

	COLOR = color;
}
"

